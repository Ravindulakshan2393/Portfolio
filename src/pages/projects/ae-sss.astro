---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const project = {
  title: "AE-SSS: Agentic Edge-AI Smart Surveillance & Response System",
  subtitle: "IEEE CS R10 Summer School 2026 Mini-Ideathon — 2nd Place Winner",
  award: "2nd Place Winner (IEEE CS R10 Summer School 2026 Mini-Ideathon)",
  target: "Pettah Central Bus Stand, Colombo, Sri Lanka",
  team: [
    { name: "Sadeepa Lakshan", inst: "UOM" },
    { name: "Chamika Umesh", inst: "UOS" },
    { name: "Aadhil Akuthub", inst: "OUSL" },
    { name: "Hiumie Hungampola", inst: "UOK" },
    { name: "Rometh De Silva", inst: "UOK" },
    { name: "Amanda Ariyaratne", inst: "UOM" }
  ],
  repository: "https://github.com/chamika-u/mini-ideathon-smart-ecosystem.git",
  image: `${baseUrl}assets/projects/aesss-team.jpg`,
  certificateImage: `${baseUrl}assets/awards/ieee-cs-r10-certificate.jpg`,
  techStack: [
    "NVIDIA Jetson Orin Nano (8GB)",
    "YOLOv8 + TensorRT INT8",
    "Acoustic NLP (Sinhala / Tamil / English)",
    "Local LLM + RAG (Vector DB)",
    "mTLS 1.3 + TPM 2.0 / ATECC608A",
    "MQTT over TLS 1.3",
    "Edge System Architecture"
  ],
  metrics: [
    { label: "Inference Latency", value: "< 50 ms" },
    { label: "Bandwidth & Power Saved", value: "> 99%" },
    { label: "HITL Override Window", value: "30 Seconds" },
    { label: "Ephemeral Buffer", value: "10-min FIFO RAM" }
  ]
};
---

<BaseLayout 
  title={`${project.title} | Case Study`}
  description="IEEE CS R10 Summer School 2026 Mini-Ideathon 2nd Place Winner — Agentic Edge-AI Smart Surveillance System by Team Busy Bees."
  isHome={false}
>
  <section class="section aesss-container" style="padding-top: 125px; padding-bottom: 4rem; min-height: 85vh;">
    <div class="container" style="max-width: 1140px;">
      
      <!-- Top Back Navigation -->
      <div style="margin-bottom: 1.8rem;">
        <a href={`${baseUrl}#awards`} class="link-btn" style="display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-arrow-left"></i> Back to Awards & Recognition
        </a>
      </div>

      <!-- Hero Header Banner with Group Photo Overlay -->
      <div class="hero-banner-card">
        <div class="banner-image-wrapper">
          <img 
            src={project.image} 
            alt="Team Busy Bees - IEEE CS R10 Mini-Ideathon 2nd Place Winners" 
            class="banner-image"
          />
          <div class="banner-overlay"></div>
        </div>
        
        <div class="banner-content">
          <div class="badge-row">
            <span class="pill-badge pill-gold">
              <i class="fa-solid fa-trophy"></i> {project.award}
            </span>
            <span class="pill-badge pill-sky">
              <i class="fa-solid fa-brain"></i> System Architecture Proposal
            </span>
            <span class="pill-badge pill-emerald">
              <i class="fa-solid fa-location-dot"></i> {project.target}
            </span>
          </div>
          
          <h1 class="banner-title">
            AE-SSS: <span class="text-gradient">Agentic Edge-AI</span> Smart Surveillance & Response System
          </h1>
          <p class="banner-desc">
            A future-oriented multi-agent edge-AI surveillance architecture designed to convert passive CCTV infrastructure into autonomous real-time safety guardians for high-density public transit terminals.
          </p>
        </div>
      </div>

      <!-- 4 Core Architecture Metrics Grid -->
      <div class="metrics-grid">
        {project.metrics.map(m => (
          <div class="metric-card">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>

      <!-- Main Content & Sidebar Layout -->
      <div class="detail-layout">
        
        <!-- Main Case Study Content -->
        <div class="detail-main">
          
          <!-- 1. Problem Context & Proposal Objectives -->
          <article class="terminal-card content-card">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">Problem Context & Proposal Objectives</span>
            </div>
            <div class="terminal-body" style="line-height: 1.8;">
              <h2 class="section-heading">
                <i class="fa-solid fa-triangle-exclamation" style="color: var(--accent-orange); margin-right: 8px;"></i>
                1. Problem Context & Objectives
              </h2>
              <p style="color: var(--text-muted); margin-bottom: 1.2rem;">
                <strong>Pettah Central Bus Stand</strong> is Sri Lanka's largest and most congested ground transit terminal, handling hundreds of thousands of daily commuters. High passenger density, continuous vehicular turnover, and open-air platforms create distinct vulnerabilities: pickpocketing, crowd surge stampedes, unauthorized commercial obstruction, and delayed responses to peak-heat cardiac or dehydration collapses.
              </p>
              <p style="color: var(--text-muted); margin-bottom: 1rem;">
                The <strong>AE-SSS architecture</strong> resolves four chronic structural deficiencies of conventional municipal CCTV setups:
              </p>
              
              <div class="bottlenecks-list">
                <div class="bottleneck-item">
                  <div class="bottleneck-icon"><i class="fa-solid fa-hourglass-end"></i></div>
                  <div>
                    <h4 style="color: var(--text-main); margin-bottom: 4px;">Passive Forensic Delay</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">
                      Transforms retroactive, post-incident forensic video scrubbing into sub-second autonomous threat classification and real-time deterrence.
                    </p>
                  </div>
                </div>

                <div class="bottleneck-item">
                  <div class="bottleneck-icon"><i class="fa-solid fa-network-wired"></i></div>
                  <div>
                    <h4 style="color: var(--text-main); margin-bottom: 4px;">Severe WAN Bandwidth & Power Drain</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">
                      Halts continuous 24/7 cloud RTSP raw streaming, slashing WAN bandwidth utilization and cloud transmission power by over <strong>99%</strong> via localized compute on the edge.
                    </p>
                  </div>
                </div>

                <div class="bottleneck-item">
                  <div class="bottleneck-icon"><i class="fa-solid fa-filter"></i></div>
                  <div>
                    <h4 style="color: var(--text-main); margin-bottom: 4px;">False Alarm Fatigue</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">
                      Suppresses false triggers in chaotic crowd environments using multi-sensor spatial-temporal fusion (visual bounding box coordinates cross-validated with acoustic beamforming arrays).
                    </p>
                  </div>
                </div>

                <div class="bottleneck-item">
                  <div class="bottleneck-icon"><i class="fa-solid fa-user-shield"></i></div>
                  <div>
                    <h4 style="color: var(--text-main); margin-bottom: 4px;">Mass Public Privacy Violations</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">
                      Guarantees privacy-by-design by running exclusively in volatile RAM and discarding unflagged footage through continuous rolling buffer overwrites.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <!-- 2. 5-Tier System Architecture -->
          <article class="terminal-card content-card">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">5-Tier Edge System Architecture</span>
            </div>
            <div class="terminal-body" style="line-height: 1.8;">
              <h2 class="section-heading">
                <i class="fa-solid fa-layer-group" style="color: var(--primary); margin-right: 8px;"></i>
                2. 5-Tier Architecture Hierarchy
              </h2>
              <p style="color: var(--text-muted); margin-bottom: 1.4rem;">
                The complete system spans five decoupled, resilient tiers designed for zero single points of failure:
              </p>

              <div class="tiers-stack">
                <div class="tier-card">
                  <div class="tier-number">Tier 1</div>
                  <div class="tier-info">
                    <h4>Physical Sensors & Ingestion</h4>
                    <p>4K optical surveillance cameras, 4-microphone beamforming directional audio arrays, and environmental temperature/PIR occupancy sensors.</p>
                  </div>
                </div>

                <div class="tier-card">
                  <div class="tier-number">Tier 2</div>
                  <div class="tier-info">
                    <h4>Device & Capture Tier</h4>
                    <p>Edge frame grabbing, hardware-accelerated H.264/H.265 decoding, audio beam steering, and volatile memory ring-buffering.</p>
                  </div>
                </div>

                <div class="tier-card tier-highlight">
                  <div class="tier-number" style="color: var(--primary);">Tier 3</div>
                  <div class="tier-info">
                    <h4>Edge Gateway & Compute (NVIDIA Jetson Orin Nano 8GB)</h4>
                    <p>Hosts TensorRT-accelerated YOLOv8 object detection, acoustic keyword spotters, local lightweight LLM + vector database for policy checking, and multi-agent coordination.</p>
                  </div>
                </div>

                <div class="tier-card">
                  <div class="tier-number">Tier 4</div>
                  <div class="tier-info">
                    <h4>Secure Network & Transport</h4>
                    <p>mTLS 1.3 encrypted mesh, MQTT over TLS 1.3 message broker, with hardware-backed cryptographic identity secured via TPM 2.0 / ATECC608A secure elements.</p>
                  </div>
                </div>

                <div class="tier-card">
                  <div class="tier-number">Tier 5</div>
                  <div class="tier-info">
                    <h4>Platform, Cloud & Application Dispatch</h4>
                    <p>Aggregated telemetry audit logs, model retraining triggers, transit security mobile application, Sri Lanka Police dispatch console, and 1990 Suwa Seriya ambulance API.</p>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <!-- 3. 5-Stage Agentic Control Loop -->
          <article class="terminal-card content-card">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">5-Stage Agentic Control Loop</span>
            </div>
            <div class="terminal-body" style="line-height: 1.8;">
              <h2 class="section-heading">
                <i class="fa-solid fa-arrows-spin" style="color: var(--secondary); margin-right: 8px;"></i>
                3. The 5-Stage Control Loop
              </h2>
              <p style="color: var(--text-muted); margin-bottom: 1.4rem;">
                Autonomous edge agents collaborate through a cyclical 5-stage feedback pipeline:
              </p>

              <div class="loop-grid">
                <div class="loop-step">
                  <div class="loop-badge">1. MONITOR</div>
                  <h4>Sensory Ingestion</h4>
                  <p>In-memory visual frames & acoustic signals ingested with sub-50ms inference via INT8 YOLOv8 and multilingual acoustic spotters.</p>
                </div>

                <div class="loop-step">
                  <div class="loop-badge">2. REASON</div>
                  <h4>Multi-Sensor Fusion</h4>
                  <p>Cross-references visual bounding boxes with acoustic distress keywords in Sinhala, Tamil, and English to verify incident context.</p>
                </div>

                <div class="loop-step">
                  <div class="loop-badge">3. VALIDATE</div>
                  <h4>Policy & HITL Guard</h4>
                  <p>Queries localized LLM + RAG vector DB against municipal safety bylaws; initiates 30s Human-in-the-Loop override window.</p>
                </div>

                <div class="loop-step">
                  <div class="loop-badge">4. ACT</div>
                  <h4>Targeted Actuation</h4>
                  <p>Triggers tiered responses: directional PA announcements, transit guard mobile alerts, or encrypted emergency API dispatch payloads.</p>
                </div>

                <div class="loop-step">
                  <div class="loop-badge">5. LEARN</div>
                  <h4>Adaptive Telemetry</h4>
                  <p>Aggregates anonymized detection confidence metrics to refine localized threshold weights without exposing raw private video.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- 4. Automated Response Matrix -->
          <article class="terminal-card content-card">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">Automated Incident Response Matrix</span>
            </div>
            <div class="terminal-body" style="line-height: 1.8;">
              <h2 class="section-heading">
                <i class="fa-solid fa-table-cells" style="color: var(--accent-gold); margin-right: 8px;"></i>
                4. Automated Incident Response Matrix
              </h2>
              <p style="color: var(--text-muted); margin-bottom: 1.2rem;">
                Based on incident severity, the system executes progressive escalations:
              </p>

              <div class="table-responsive">
                <table class="custom-table">
                  <thead>
                    <tr>
                      <th>Severity Tier</th>
                      <th>Detected Event</th>
                      <th>Automated Actuation</th>
                      <th>Target Endpoint</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><span class="tier-badge tier-l1">Level 1</span></td>
                      <td>Littering, unauthorized hawker stalls, terminal aisle obstruction</td>
                      <td>Localized directional PA advisory broadcast</td>
                      <td>On-site platform directional PA</td>
                    </tr>
                    <tr>
                      <td><span class="tier-badge tier-l2">Level 2</span></td>
                      <td>Pickpocketing, crowd surge bottlenecks, dispute escalation</td>
                      <td>30s HITL confirmation warning + silent vibration alert</td>
                      <td>Bus Stand Security Mobile App</td>
                    </tr>
                    <tr>
                      <td><span class="tier-badge tier-l3a">Level 3A</span></td>
                      <td>Physical assault, dangerous weapon flag, organized violence</td>
                      <td>Live suspect tracking vector + encrypted alert packet</td>
                      <td>Sri Lanka Police (Pettah Division)</td>
                    </tr>
                    <tr>
                      <td><span class="tier-badge tier-l3b">Level 3B</span></td>
                      <td>Commuter collapse, heat stroke, unconscious individual</td>
                      <td>Instant GPS coordinate payload & vital telemetry flag</td>
                      <td>1990 Suwa Seriya Ambulance API</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </article>

          <!-- 5. Verification Suite & Passing Tests -->
          <article class="terminal-card content-card">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">Verification & Testing Suite</span>
            </div>
            <div class="terminal-body" style="line-height: 1.8;">
              <h2 class="section-heading">
                <i class="fa-solid fa-circle-check" style="color: var(--accent-emerald); margin-right: 8px;"></i>
                5. Verification Suite (13 Automated Tests Passing)
              </h2>
              <p style="color: var(--text-muted); margin-bottom: 1.2rem;">
                The prototype codebase includes a Python <code>unittest</code> suite with <strong>13 automated test cases passing</strong>, verifying multi-agent state machines, FIFO memory recycling, and emergency API dispatchers:
              </p>

              <div class="tests-grid">
                <div class="test-item">
                  <i class="fa-solid fa-check test-icon"></i>
                  <span>FIFO RAM Buffer 10-minute overwrite recycling & memory ceiling bounds</span>
                </div>
                <div class="test-item">
                  <i class="fa-solid fa-check test-icon"></i>
                  <span>Spatial-temporal cross-correlation between audio spikes and YOLOv8 visual boxes</span>
                </div>
                <div class="test-item">
                  <i class="fa-solid fa-check test-icon"></i>
                  <span>30-second HITL countdown expiration, manual override, and escalation triggers</span>
                </div>
                <div class="test-item">
                  <i class="fa-solid fa-check test-icon"></i>
                  <span>1990 Suwa Seriya payload formatting & GPS coordinates encryption schema</span>
                </div>
                <div class="test-item">
                  <i class="fa-solid fa-check test-icon"></i>
                  <span>mTLS 1.3 handshake & TPM 2.0 key verification on MQTT publish/subscribe</span>
                </div>
                <div class="test-item">
                  <i class="fa-solid fa-check test-icon"></i>
                  <span>Graceful edge gateway failover during simulated WAN disconnects</span>
                </div>
              </div>
            </div>
          </article>

          <!-- 6. Privacy & SDG Alignment -->
          <article class="terminal-card content-card">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">Privacy-by-Design & UN SDG Alignment</span>
            </div>
            <div class="terminal-body" style="line-height: 1.8;">
              <h2 class="section-heading">
                <i class="fa-solid fa-earth-americas" style="color: var(--accent-emerald); margin-right: 8px;"></i>
                6. Privacy-by-Design & UN SDG Alignment
              </h2>
              <p style="color: var(--text-muted); margin-bottom: 1.2rem;">
                Public surveillance must respect civil liberties. AE-SSS incorporates an ephemeral <strong style="color: var(--text-main);">10-Minute Rolling FIFO RAM Buffer</strong> encrypted with <strong style="color: var(--text-main);">AES-256-GCM</strong> directly on hardware memory. Unflagged footage is permanently overwritten every second, ensuring raw public imagery never touches persistent non-volatile disks.
              </p>

              <div class="sdg-grid">
                <div class="sdg-card">
                  <div class="sdg-num" style="color: var(--primary);">SDG 11</div>
                  <h4>Sustainable Cities & Communities</h4>
                  <p>Guarantees secure, accessible public transportation hubs for women, children, and elderly citizens.</p>
                </div>
                <div class="sdg-card">
                  <div class="sdg-num" style="color: var(--accent-emerald);">SDG 13</div>
                  <h4>Climate Action</h4>
                  <p>Reduces cloud streaming bandwidth and server farm carbon footprints by &gt;99% via edge inference.</p>
                </div>
                <div class="sdg-card">
                  <div class="sdg-num" style="color: var(--accent-purple);">SDG 3</div>
                  <h4>Good Health & Well-Being</h4>
                  <p>Cuts emergency medical response times during heat exhaustion or cardiac events through direct 1990 dispatch.</p>
                </div>
              </div>
            </div>
          </article>

        </div>

        <!-- Right Sidebar Info Cards -->
        <aside class="detail-sidebar">
          
          <!-- Official Certificate of Achievement Card -->
          <div class="sidebar-box cert-card">
            <div class="cert-header">
              <span class="cert-icon">🏆</span>
              <h3>Official Award Certificate</h3>
            </div>
            <p class="cert-subtext">
              Awarded <strong>2nd Place</strong> in the IEEE Computer Society R10 Summer School 2026 Mini-Ideathon for outstanding creativity, innovation, and problem-solving.
            </p>
            <div class="cert-image-wrapper">
              <div class="certificate-watermark-overlay" aria-hidden="true">
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
              </div>
              <img 
                src={project.certificateImage} 
                alt="Official IEEE CS R10 Summer School 2026 Mini-Ideathon 2nd Place Certificate - W. S. L. R. Perera" 
                class="cert-img"
              />
            </div>
            <div class="cert-signatures">
              <span><strong>Signed:</strong> Prof. Supunmali Ahangama (Chairperson)</span>
              <span><strong>Signed:</strong> Dr. Suresha Perera (Secretary)</span>
            </div>
            <div style="margin-top: 0.9rem;">
              <div class="cert-status-badge" style="justify-content: center; width: 100%;">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Protected Digital Credential</span>
              </div>
            </div>
          </div>

          <!-- Social Impact Box (Medicine Purchase Highlight) -->
          <div class="sidebar-box social-impact-card">
            <div class="social-impact-header">
              <span class="impact-emoji">💊</span>
              <h3>Social Impact Donation</h3>
            </div>
            <p class="social-impact-text">
              Demonstrating social responsibility, <strong>Team Busy Bees</strong> utilized their entire IEEE CS R10 Ideathon 2nd Place cash prize to purchase and donate essential chemotherapy and supportive medications for pediatric cancer patients at the <strong>Apeksha National Cancer Hospital (Maharagama)</strong>.
            </p>
          </div>

          <!-- Proposed Tech Stack Card -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">Proposed Tech Stack</h3>
            <div class="stack-tags-list">
              {project.techStack.map(tech => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>
          </div>

          <!-- Team Members Card (Verified Roster) -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">Team Busy Bees</h3>
            <ul class="team-list">
              {project.team.map(m => (
                <li class="team-member-item">
                  <span class="member-name"><i class="fa-solid fa-angle-right" style="color: var(--primary); margin-right: 6px;"></i>{m.name}</span>
                  <span class="member-inst">{m.inst}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Repository CTA Card -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">Ideathon Repository</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
              Explore the full system architecture documentation, data schemas, and edge agent pipeline definitions.
            </p>
            <a 
              href={project.repository} 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn btn-primary"
              style="width: 100%; justify-content: center; font-size: 0.9rem;"
            >
              <i class="fa-brands fa-github"></i> View GitHub Repository <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.75rem; margin-left: 4px;"></i>
            </a>
          </div>

        </aside>

      </div>

      <!-- Bottom Action CTA -->
      <div class="github-cta-box" style="margin-top: 3.5rem;">
        <div class="cta-info">
          <i class="fa-solid fa-trophy cta-icon" style="color: var(--accent-gold);"></i>
          <div>
            <h4>Honored by IEEE Computer Society Region 10</h4>
            <p>Team Busy Bees presented this edge-AI architecture at the IEEE CS R10 Summer School 2026 Mini-Ideathon.</p>
          </div>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href={`${baseUrl}#awards`} class="btn btn-primary">
            <i class="fa-solid fa-trophy"></i> View All Awards
          </a>
          <a href={project.repository} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <i class="fa-brands fa-github"></i> View GitHub Repo
          </a>
          <a href={`${baseUrl}#contact`} class="btn btn-secondary">
            <i class="fa-solid fa-envelope"></i> Contact Sadeepa
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Banner */
  .hero-banner-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-card);
  }

  .banner-image-wrapper {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-banner-card:hover .banner-image {
    transform: scale(1.03);
  }

