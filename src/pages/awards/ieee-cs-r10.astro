---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const award = {
  title: "IEEE CS R10 Summer School 2026 Mini-Ideathon",
  subtitle: "2nd Place Winner — Team Busy Bees",
  organization: "IEEE Computer Society Region 10",
  year: "2026",
  recipient: "W. S. L. R. Perera (Sadeepa Lakshan)",
  citation: "Awarded 2nd Place in the IEEE Computer Society R10 Summer School 2026 Mini-Ideathon for outstanding creativity, engineering innovation, and technical presentation with Team Busy Bees.",
  signatories: [
    {
      name: "Prof. Supunmali Ahangama",
      role: "Chairperson",
      org: "IEEE CS Sri Lanka Chapter"
    },
    {
      name: "Dr. Suresha Perera",
      role: "Secretary",
      org: "IEEE CS Sri Lanka Chapter"
    }
  ],
  metrics: [
    { label: "Award Rank", value: "2nd Place" },
    { label: "Host Body", value: "IEEE CS R10" },
    { label: "Team", value: "Busy Bees" },
    { label: "Year", value: "2026" }
  ],
  certificateImage: `${baseUrl}assets/awards/ieee-cs-r10-certificate.jpg`
};
---

<BaseLayout 
  title={`${award.title} | Awards & Recognition`}
  description="Official 2nd Place Winner Certificate — IEEE CS R10 Summer School 2026 Mini-Ideathon awarded to Sadeepa Lakshan (Team Busy Bees)."
  isHome={false}
>
  <section class="section award-detail-container" style="padding-top: 125px; padding-bottom: 4rem; min-height: 85vh;">
    <div class="container" style="max-width: 1140px;">
      
      <!-- Top Back Navigation -->
      <div style="margin-bottom: 1.8rem; display: flex; gap: 12px; flex-wrap: wrap;">
        <a href={`${baseUrl}#awards`} class="link-btn" style="display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-arrow-left"></i> Back to Awards & Recognition
        </a>
        <a href={`${baseUrl}projects/ae-sss`} class="link-btn" style="display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-brain"></i> View Project Case Study <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <!-- Compact Hero Header Card -->
      <div class="award-header-card">
        <div class="award-header-main">
          <div class="badge-row">
            <span class="pill-badge pill-gold">
              <i class="fa-solid fa-trophy"></i> 2nd Place Winner
            </span>
            <span class="pill-badge pill-sky">
              <i class="fa-solid fa-microchip"></i> IEEE Computer Society Region 10
            </span>
            <span class="pill-badge pill-emerald">
              <i class="fa-solid fa-calendar-check"></i> 2026 Mini-Ideathon
            </span>
          </div>
          
          <h1 class="award-page-title">
            IEEE CS R10 Summer School <span class="text-gradient">2026 Mini-Ideathon</span>
          </h1>
          <p class="award-page-desc">
            Official 2nd Place recognition conferred by the IEEE Computer Society Region 10 honoring <strong>Team Busy Bees</strong> for designing and presenting the Agentic Edge-AI Smart Surveillance System (AE-SSS) for high-density public transit terminals.
          </p>
        </div>

        <!-- 4 Inline Quick Metrics -->
        <div class="inline-metrics-bar">
          {award.metrics.map(m => (
            <div class="inline-metric-item">
              <span class="inline-metric-label">{m.label}</span>
              <span class="inline-metric-value">{m.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Main Balanced 2-Column Split: Verified Certificate (Left) & Award Details (Right) -->
      <div class="award-split-layout">
        
        <!-- Left: Verified Certificate Showcase -->
        <article class="terminal-card content-card certificate-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">Official IEEE Certificate Document</span>
          </div>
          
          <div class="terminal-body" style="padding: 1.4rem 1.5rem;">
            <div class="card-subtitle-row">
              <h2 class="section-heading" style="margin-bottom: 0;">
                <i class="fa-solid fa-file-shield" style="color: var(--primary); margin-right: 8px;"></i>
                Verified Credential
              </h2>
              <span class="verified-pill">
                <i class="fa-solid fa-circle-check"></i> Authentic
              </span>
            </div>

            <div class="certificate-frame">
              <div class="certificate-watermark-overlay" aria-hidden="true">
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
              </div>
              <img 
                src={award.certificateImage} 
                alt="Official IEEE CS R10 Summer School 2026 Mini-Ideathon 2nd Place Certificate - W. S. L. R. Perera" 
                class="certificate-full-img"
                loading="eager"
              />
            </div>

            <div class="cert-footer-row">
              <span class="cert-caption">
                <i class="fa-solid fa-award" style="color: var(--accent-gold);"></i> 2nd Place • IEEE CS R10 Mini-Ideathon
              </span>
              <div class="cert-status-badge">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Protected Digital Credential</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Right: Award Citation, Credentials & Signatories -->
        <article class="terminal-card content-card details-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">Official Citation & Verification</span>
          </div>
          
          <div class="terminal-body" style="padding: 1.4rem 1.5rem;">
            
            <div class="card-subtitle-row">
              <h2 class="section-heading" style="margin-bottom: 0;">
                <i class="fa-solid fa-certificate" style="color: var(--accent-gold); margin-right: 8px;"></i>
                Citation of Honor
              </h2>
              <span class="verified-pill">
                <i class="fa-solid fa-medal"></i> 2nd Place
              </span>
            </div>

            <!-- Citation Blockquote -->
            <div class="citation-callout">
              <i class="fa-solid fa-quote-left quote-icon"></i>
              <blockquote class="citation-text">
                "{award.citation}"
              </blockquote>
              <div class="citation-author">
                — Conferred to <strong>{award.recipient}</strong> by IEEE Computer Society Region 10
              </div>
            </div>

            <!-- Social Impact Box -->
            <div class="social-impact-callout">
              <div class="social-impact-title">
                <span style="font-size: 1.2rem;">💊</span>
                <strong>Philanthropic Social Impact</strong>
              </div>
              <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
                Team Busy Bees donated their entire 2nd Place cash prize to purchase and supply life-saving chemotherapy medications for pediatric cancer patients at the <strong>Apeksha National Cancer Hospital (Maharagama)</strong>.
              </p>
            </div>

            <!-- 4-Item Credentials Matrix -->
            <div class="credentials-balanced-grid" style="margin-top: 1.2rem;">
              <div class="cred-item">
                <span class="cred-label">Award Title</span>
                <span class="cred-value">{award.title}</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Awardee</span>
                <span class="cred-value">{award.recipient}</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Organizing Body</span>
                <span class="cred-value">{award.organization}</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Project Architecture</span>
                <span class="cred-value">AE-SSS Edge-AI</span>
              </div>
            </div>

            <!-- Official Signatories Section -->
            <div class="signatories-section">
              <span class="cred-label" style="display: block; margin-bottom: 0.6rem;">Verified Signatories</span>
              <div class="signatories-balanced-row">
                {award.signatories.map(s => (
                  <div class="signatory-box">
                    <div class="signatory-name">
                      <i class="fa-solid fa-pen-nib" style="color: var(--primary); margin-right: 5px;"></i>
                      <strong>{s.name}</strong>
                    </div>
                    <div class="signatory-role">{s.role}</div>
                    <div class="signatory-org">{s.org}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Deep Dive Action Link -->
            <div style="margin-top: 1.5rem;">
              <a href={`${baseUrl}projects/ae-sss`} class="btn btn-primary" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px;">
                <i class="fa-solid fa-brain"></i> Explore Full AE-SSS Architecture Case Study <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>

          </div>
        </article>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .award-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.2rem 2.4rem;
    margin-bottom: 2.2rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1rem;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .pill-gold {
    background: rgba(251, 191, 36, 0.15);
    color: #fde68a;
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .pill-sky {
    background: rgba(56, 189, 248, 0.15);
    color: #bae6fd;
    border: 1px solid rgba(56, 189, 248, 0.4);
  }

  .pill-emerald {
    background: rgba(62, 207, 142, 0.15);
    color: #a7f3d0;
    border: 1px solid rgba(62, 207, 142, 0.4);
  }

  .award-page-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.3;
    margin-bottom: 0.8rem;
  }

  .award-page-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  .inline-metrics-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border-color);
  }

  .inline-metric-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .inline-metric-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-dim);
    font-weight: 600;
  }

  .inline-metric-value {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--primary);
  }

  /* 2-Column Split Layout */
  .award-split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .card-subtitle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-heading {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .verified-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .certificate-frame {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: #000;
    margin-bottom: 1.2rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .certificate-full-img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .cert-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cert-caption {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .citation-callout {
    position: relative;
    background: rgba(251, 191, 36, 0.05);
    border-left: 3px solid var(--accent-gold);
    padding: 1.2rem 1.4rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 1.2rem;
  }

  .quote-icon {
    font-size: 1.3rem;
    color: var(--accent-gold);
    opacity: 0.4;
    margin-bottom: 0.4rem;
    display: block;
  }

  .citation-text {
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-main);
    margin: 0 0 0.8rem 0;
  }

  .citation-author {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .social-impact-callout {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-sm);
    padding: 1rem 1.2rem;
    margin-bottom: 1rem;
  }

  .social-impact-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #10b981;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .credentials-balanced-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    margin-bottom: 1.4rem;
  }

  .cred-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0.75rem 0.9rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
  }

  .cred-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-dim);
    font-weight: 600;
  }

  .cred-value {
    font-size: 0.85rem;
    color: var(--text-main);
    font-weight: 600;
  }

  .signatories-section {
    border-top: 1px solid var(--border-color);
    padding-top: 1.2rem;
  }

  .signatories-balanced-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }

  .signatory-box {
    padding: 0.85rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .signatory-name {
    font-size: 0.85rem;
    color: var(--text-main);
    margin-bottom: 2px;
  }

  .signatory-role {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .signatory-org {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-style: italic;
  }

  /* Responsive Breakpoints */
  @media (max-width: 992px) {
    .award-split-layout {
      grid-template-columns: 1fr;
    }
    .inline-metrics-bar {
      grid-template-columns: repeat(2, 1fr);
    }
    .award-header-card {
      padding: 1.6rem 1.4rem;
    }
    .award-page-title {
      font-size: 1.6rem;
    }
  }

  @media (max-width: 768px) {
    .inline-metrics-bar {
      grid-template-columns: 1fr;
    }
    .credentials-balanced-grid {
      grid-template-columns: 1fr;
    }
    .signatories-balanced-row {
      grid-template-columns: 1fr;
    }
    .terminal-body {
      padding: 1.2rem 1rem !important;
    }
  }

  @media (max-width: 480px) {
    .award-page-title {
      font-size: 1.35rem;
    }
  }
</style>
