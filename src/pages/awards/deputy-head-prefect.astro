---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const recognition = {
  title: "Deputy Head Prefect Certificate (2021 / 2022)",
  honor: "Deputy Head Prefect Certificate",
  organization: "A/ Mankadawala Maha Vidyalaya",
  location: "Saliyapura, Sri Lanka",
  tenure: "2021 / 2022",
  prefectTenure: "2019 – 2022",
  recipient: "W. Sadeepa Lakshan Ravindu Perera (Sadeepa Lakshan)",
  citation: "Awarded for serving in the capacity of Deputy Head Prefect for the years 2021/2022 at Mankadawala Maha Vidyalaya.",
  sinhalaTitle: "උප ප්‍රධාන ශිෂ්‍ය නායක ධුරයේ කටයුතු කිරීම වෙනුවෙන් පිරිනමන ලද ශිෂ්‍ය නායක සහතිකයයි.",
  signatories: [
    {
      name: "Principal",
      role: "Head of Institution",
      org: "A/ Mankadawala Maha Vidyalaya"
    },
    {
      name: "Master-in-Charge",
      role: "Prefect Guild Advisor",
      org: "A/ Mankadawala Maha Vidyalaya"
    }
  ],
  metrics: [
    { label: "Leadership Role", value: "Deputy Head Prefect" },
    { label: "Tenure Period", value: "2021 / 2022" },
    { label: "Prefect Guild", value: "Since 2019" },
    { label: "Institution", value: "A/Mankadawala MV" }
  ],
  certificateImage: `${baseUrl}assets/awards/deputy-head-prefect-certificate.jpg`,
  ceremonyImage: `${baseUrl}assets/awards/prefect-guild-ceremony.jpg`
};
---

<BaseLayout 
  title={`${recognition.title} | Awards & Recognition`}
  description="Deputy Head Prefect Certificate awarded to Sadeepa Lakshan (W. Sadeepa Lakshan Ravindu Perera) by A/ Mankadawala Maha Vidyalaya, Saliyapura for distinguished student leadership."
  isHome={false}
>
  <section class="section award-detail-container" style="padding-top: 125px; padding-bottom: 4rem; min-height: 85vh;">
    <div class="container" style="max-width: 1140px;">
      
      <!-- Top Back Navigation -->
      <div style="margin-bottom: 1.8rem;">
        <a href={`${baseUrl}#awards`} class="link-btn" style="display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-arrow-left"></i> Back to Awards & Recognition
        </a>
      </div>

      <!-- Hero Header Banner Card with Ceremony Stage Photo Overlay -->
      <div class="hero-banner-card">
        <div class="banner-image-wrapper">
          <img 
            src={recognition.ceremonyImage} 
            alt="Prefect Guild Investiture & Badge Ceremony at A/ Mankadawala Maha Vidyalaya" 
            class="banner-image"
          />
          <div class="banner-overlay"></div>
        </div>
        
        <div class="banner-content">
          <div class="badge-row">
            <span class="pill-badge pill-gold">
              <i class="fa-solid fa-medal"></i> School Leadership Honor
            </span>
            <span class="pill-badge pill-sky">
              <i class="fa-solid fa-graduation-cap"></i> Deputy Head Prefect
            </span>
            <span class="pill-badge pill-emerald">
              <i class="fa-solid fa-building-columns"></i> A/ Mankadawala Maha Vidyalaya
            </span>
            <span class="pill-badge pill-purple">
              <i class="fa-solid fa-calendar-check"></i> Tenure 2021 / 2022
            </span>
          </div>
          
          <h1 class="banner-title">
            Deputy Head Prefect <span class="text-gradient">(2021 / 2022)</span>
          </h1>
          <p class="banner-desc">
            Official certificate conferred by <strong>A/ Mankadawala Maha Vidyalaya, Saliyapura</strong> recognizing student leadership, school governance, disciplinary management, and service as Deputy Head Prefect following active prefect guild tenure since 2019.
          </p>
        </div>
      </div>

      <!-- 4 Core Leadership Metrics Grid -->
      <div class="metrics-grid">
        {recognition.metrics.map(m => (
          <div class="metric-card">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>

      <!-- Main Balanced 2-Column Split: Certificate Showcase (Left) & Citation & History (Right) -->
      <div class="award-split-layout">
        
        <!-- Left: Verified Certificate Showcase -->
        <article class="terminal-card content-card certificate-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">Official Leadership Certificate</span>
          </div>
          
          <div class="terminal-body" style="padding: 1.4rem 1.5rem;">
            <div class="card-subtitle-row">
              <h2 class="section-heading" style="margin-bottom: 0;">
                <i class="fa-solid fa-file-shield" style="color: var(--primary); margin-right: 8px;"></i>
                Verified Credential
              </h2>
              <span class="verified-pill">
                <i class="fa-solid fa-circle-check"></i> Authentic Certificate
              </span>
            </div>

            <div class="certificate-frame">
              <div class="certificate-watermark-overlay" aria-hidden="true">
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
              </div>
              <img 
                src={recognition.certificateImage} 
                alt="Official Deputy Head Prefect Certificate - Sadeepa Lakshan" 
                class="certificate-full-img"
                loading="eager"
              />
            </div>

            <div class="cert-footer-row">
              <span class="cert-caption">
                <i class="fa-solid fa-award" style="color: var(--accent-gold);"></i> 2021 / 2022 • A/Mankadawala MV
              </span>
              <div class="cert-status-badge">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Protected Digital Credential</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Right: Official Citation, Credentials & History -->
        <article class="terminal-card content-card details-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">Leadership Citation & Governance Credentials</span>
          </div>
          
          <div class="terminal-body" style="padding: 1.4rem 1.5rem;">
            
            <div class="card-subtitle-row">
              <h2 class="section-heading" style="margin-bottom: 0;">
                <i class="fa-solid fa-quote-left" style="color: var(--accent-gold); margin-right: 8px;"></i>
                Citation of Recognition
              </h2>
              <span class="verified-pill">
                <i class="fa-solid fa-medal"></i> Executive Post
              </span>
            </div>

            <!-- Citation Blockquote -->
            <div class="citation-callout">
              <i class="fa-solid fa-quote-left quote-icon"></i>
              <blockquote class="citation-text">
                "{recognition.citation}"
              </blockquote>
              <div class="citation-author">
                — Conferred to <strong>{recognition.recipient}</strong> by A/ Mankadawala Maha Vidyalaya
              </div>
            </div>

            <p style="color: var(--text-muted); font-size: 0.86rem; line-height: 1.55; margin-bottom: 1.1rem;">
              Served in the executive post of <strong>Deputy Head Prefect</strong> during the 2021/2022 administrative term, responsible for coordinating the school prefect board, maintaining student discipline, and organizing key institutional celebrations.
            </p>

            <!-- 4-Item Credentials Matrix -->
            <div class="credentials-balanced-grid">
              <div class="cred-item">
                <span class="cred-label">Leadership Position</span>
                <span class="cred-value">Deputy Head Prefect</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Awardee</span>
                <span class="cred-value">W.S.L.R. Perera</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Institution</span>
                <span class="cred-value">A/Mankadawala MV</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Tenure Period</span>
                <span class="cred-value">2021 / 2022 (Prefect since 2019)</span>
              </div>
            </div>

            <!-- Official Signatories Section -->
            <div class="signatories-section">
              <span class="cred-label" style="display: block; margin-bottom: 0.6rem;">Institutional Signatories</span>
              <div class="signatories-balanced-row">
                {recognition.signatories.map(s => (
                  <div class="signatory-box">
                    <div class="signatory-name">
                      <i class="fa-solid fa-pen-nib" style="color: var(--primary); margin-right: 5px;"></i>
                      <strong>{s.name}</strong>
                    </div>
                    <div class="signatory-role">{s.role}</div>
                    <div class="signatory-org">{s.org}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Prefect Guild Service Roadmap Note -->
            <div class="institutional-note" style="margin-top: 1rem;">
              <i class="fa-solid fa-shield-halved" style="color: #10b981;"></i>
              <span>Prefect Guild Career: Senior Prefect (2019–2021) → Deputy Head Prefect (2021–2022)</span>
            </div>

          </div>
        </article>

      </div>

      <!-- 2. Student Governance & Prefect Guild Responsibilities -->
      <article class="terminal-card content-card" style="margin-top: 1.8rem;">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="terminal-title">Prefect Guild Leadership Portfolio</span>
        </div>
        
        <div class="terminal-body" style="padding: 1.8rem 2rem;">
          <div class="section-title-bar">
            <h2 class="section-heading" style="margin-bottom: 0;">
              <i class="fa-solid fa-users-viewfinder" style="color: var(--secondary); margin-right: 8px;"></i>
              Student Governance &amp; Prefect Guild Responsibilities
            </h2>
            <span class="section-counter-badge">A/Mankadawala MV</span>
          </div>

          <p style="color: var(--text-muted); margin-bottom: 1.4rem; font-size: 0.9rem; line-height: 1.6;">
            As Deputy Head Prefect, Sadeepa led student governance, prefect guild coordination, and institutional event logistics across three core pillars:
          </p>

          <!-- 3 Leadership Responsibilities -->
          <div class="initiatives-grid-3col">
            
            <div class="initiative-card">
              <div class="initiative-top">
                <div class="initiative-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
                  <i class="fa-solid fa-shield-halved"></i>
                </div>
                <span class="initiative-pill pill-sky">Discipline &amp; Order</span>
              </div>
              <div class="initiative-content">
                <h4 class="initiative-title">Student Governance</h4>
                <div class="initiative-role">Daily School Discipline</div>
                <p>
                  Supervised morning assemblies, student dress code compliance, corridor order, and daily school discipline across all grade levels.
                </p>
              </div>
            </div>

            <div class="initiative-card">
              <div class="initiative-top">
                <div class="initiative-icon" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24;">
                  <i class="fa-solid fa-flag"></i>
                </div>
                <span class="initiative-pill pill-gold">Event Operations</span>
              </div>
              <div class="initiative-content">
                <h4 class="initiative-title">Flagship Event Coordination</h4>
                <div class="initiative-role">Institutional Ceremonies</div>
                <p>
                  Led prefect teams in organizing annual sports meets, prize-giving ceremonies, educational exhibitions, and commemorative school celebrations.
                </p>
              </div>
            </div>

            <div class="initiative-card">
              <div class="initiative-top">
                <div class="initiative-icon" style="background: rgba(62, 207, 142, 0.15); color: #3ecf8e;">
                  <i class="fa-solid fa-hands-holding"></i>
                </div>
                <span class="initiative-pill pill-emerald">Mentorship</span>
              </div>
              <div class="initiative-content">
                <h4 class="initiative-title">Prefect Guild Mentoring</h4>
                <div class="initiative-role">Junior Leadership Training</div>
                <p>
                  Mentored probationary and junior prefects, training them in leadership, communication, protocol, crisis handling, and responsible stewardship.
                </p>
              </div>
            </div>

          </div>
        </div>
      </article>

      <!-- 3. Core Leadership Attributes -->
      <article class="terminal-card content-card" style="margin-top: 1.8rem;">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="terminal-title">Leadership Core Values</span>
        </div>
        
        <div class="terminal-body" style="padding: 1.8rem 2rem;">
          <h2 class="section-heading" style="margin-bottom: 1.2rem;">
            <i class="fa-solid fa-compass" style="color: var(--accent-gold); margin-right: 8px;"></i>
            Attributes Developed as Deputy Head Prefect
          </h2>

          <div class="pillars-grid-4col">
            <div class="pillar-box">
              <div class="pillar-num">01</div>
              <h4>Integrity &amp; Role Modeling</h4>
              <p>Leading by personal example in academics, conduct, punctuality, and commitment to institutional values.</p>
            </div>
            <div class="pillar-box">
              <div class="pillar-num">02</div>
              <h4>Team Stewardship</h4>
              <p>Guiding a diverse prefect guild with empathy, clear delegation of duties, and high motivational standards.</p>
            </div>
            <div class="pillar-box">
              <div class="pillar-num">03</div>
              <h4>Conflict Resolution</h4>
              <p>Handling student disputes, maintaining peace, and acting as a trustworthy bridge with teachers and administration.</p>
            </div>
            <div class="pillar-box">
              <div class="pillar-num">04</div>
              <h4>Operational Readiness</h4>
              <p>Managing stage management, crowd control, and emergency protocols during large-scale school events.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Bottom Action CTA -->
      <div class="github-cta-box" style="margin-top: 2.5rem;">
        <div class="cta-info">
          <i class="fa-solid fa-award cta-icon" style="color: var(--accent-gold);"></i>
          <div>
            <h4>Explore Recognition &amp; Technical Projects</h4>
            <p>Discover technical case studies in IoT, Edge-AI, and full-stack software development.</p>
          </div>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href={`${baseUrl}awards/nena-aruna`} class="btn btn-primary">
            <i class="fa-solid fa-file-invoice"></i> View Nena Aruna Letter
          </a>
          <a href={`${baseUrl}awards/spirit-of-service`} class="btn btn-secondary">
            <i class="fa-solid fa-medal"></i> View Spirit of Service Award
          </a>
          <a href={`${baseUrl}#awards`} class="btn btn-secondary">
            <i class="fa-solid fa-award"></i> View All Awards
          </a>
          <a href={`${baseUrl}#contact`} class="btn btn-secondary">
            <i class="fa-solid fa-envelope"></i> Contact Sadeepa
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Banner Card */
  .hero-banner-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .banner-image-wrapper {
    position: relative;
    width: 100%;
    height: 320px;
    overflow: hidden;
    background: #0b0f19;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: blur(3px);
    transform: scale(1.04);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s ease;
  }

  .hero-banner-card:hover .banner-image {
    transform: scale(1.07);
    filter: blur(2px);
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 10, 18, 0.97) 0%, rgba(7, 10, 18, 0.65) 45%, rgba(7, 10, 18, 0.25) 100%);
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
  }

  .banner-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.8rem 2.2rem;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 0.8rem;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }

  .pill-gold {
    background: rgba(251, 191, 36, 0.15);
    color: #fde68a;
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .pill-sky {
    background: rgba(56, 189, 248, 0.15);
    color: #bae6fd;
    border: 1px solid rgba(56, 189, 248, 0.4);
  }

  .pill-emerald {
    background: rgba(62, 207, 142, 0.15);
    color: #a7f3d0;
    border: 1px solid rgba(62, 207, 142, 0.4);
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.15);
    color: #e9d5ff;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .banner-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .banner-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 880px;
    line-height: 1.5;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-bottom: 1.5rem;
  }

  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.1rem 1rem;
    text-align: center;
    transition: var(--transition-normal);
  }

  .metric-card:hover {
    border-color: rgba(251, 191, 36, 0.4);
    transform: translateY(-2px);
  }

  .metric-value {
    font-size: 1.15rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    margin-bottom: 0.25rem;
  }

  .metric-label {
    font-size: 0.76rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  /* Award Split Layout (Balanced 2 Columns) */
  .award-split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .terminal-header {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .card-subtitle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
  }

  .verified-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  /* Certificate Frame */
  .certificate-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    background: rgba(0, 0, 0, 0.2);
    margin-bottom: 0.8rem;
  }

  .certificate-full-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .cert-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 8px;
  }

  .cert-caption {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Citation Callout */
  .citation-callout {
    position: relative;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.08) 0%, rgba(15, 23, 42, 0.4) 100%);
    border-left: 3px solid var(--accent-gold);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 1.1rem 1.4rem;
    margin-bottom: 1rem;
  }

  .quote-icon {
    position: absolute;
    top: 0.8rem;
