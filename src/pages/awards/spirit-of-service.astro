---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const award = {
  title: "Spirit of Service Award 2024/25",
  organization: "Rotaract Club of University of Moratuwa",
  year: "RI Year 2024/25",
  recipient: "Sadeepa Lakshan",
  citation: "For showcasing immense drive, passion, and commitment in upholding the true spirit of service and duty throughout the RI year 2024/25 under the Rotaract Club of University of Moratuwa through their dedicated time and effort.",
  signatories: [
    {
      name: "Dr. Ranga Rodrigo",
      role: "Senior Treasurer and Staff Advisor",
      org: "Rotaract Club of University of Moratuwa"
    },
    {
      name: "Rtr. Hiruni Praveesha",
      role: "President 2024-25",
      org: "Rotaract Club of University of Moratuwa"
    }
  ],
  metrics: [
    { label: "Recognition Year", value: "RI 2024/25" },
    { label: "Host Organization", value: "Rotaract UoM" },
    { label: "Flagship Project", value: "Nena Aruna" },
    { label: "Award Honor", value: "Spirit of Service" }
  ],
  certificateImage: `${baseUrl}assets/awards/spirit-of-service-certificate.jpg`
};
---

<BaseLayout 
  title={`${award.title} | Awards & Recognition`}
  description="Rotaract Club of University of Moratuwa Spirit of Service Award 2024/25 presented to Sadeepa Lakshan for outstanding leadership, commitment, and community service."
  isHome={false}
>
  <section class="section award-detail-container" style="padding-top: 125px; padding-bottom: 4rem; min-height: 85vh;">
    <div class="container" style="max-width: 1140px;">
      
      <!-- Top Back Navigation -->
      <div style="margin-bottom: 1.8rem;">
        <a href={`${baseUrl}#awards`} class="link-btn" style="display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-arrow-left"></i> Back to Awards & Recognition
        </a>
      </div>

      <!-- Compact Hero Header Card -->
      <div class="award-header-card">
        <div class="award-header-main">
          <div class="badge-row">
            <span class="pill-badge pill-gold">
              <i class="fa-solid fa-medal"></i> Spirit of Service Award
            </span>
            <span class="pill-badge pill-sky">
              <i class="fa-solid fa-building-columns"></i> Rotaract Club of University of Moratuwa
            </span>
            <span class="pill-badge pill-emerald">
              <i class="fa-solid fa-calendar-check"></i> RI Year 2024/25
            </span>
          </div>
          
          <h1 class="award-page-title">
            Spirit of Service <span class="text-gradient">Award 2024/25</span>
          </h1>
          <p class="award-page-desc">
            Official recognition awarded by the Rotaract Club of University of Moratuwa honoring exceptional volunteerism, community impact, and dedicated duty across multiple university and societal initiatives.
          </p>
        </div>

        <!-- 4 Inline Quick Metrics -->
        <div class="inline-metrics-bar">
          {award.metrics.map(m => (
            <div class="inline-metric-item">
              <span class="inline-metric-label">{m.label}</span>
              <span class="inline-metric-value">{m.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Main Balanced 2-Column Split: Verified Certificate (Left) & Award Details (Right) -->
      <div class="award-split-layout">
        
        <!-- Left: Verified Certificate Showcase -->
        <article class="terminal-card content-card certificate-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">Official Certificate Document</span>
          </div>
          
          <div class="terminal-body" style="padding: 1.4rem 1.5rem;">
            <div class="card-subtitle-row">
              <h2 class="section-heading" style="margin-bottom: 0;">
                <i class="fa-solid fa-file-shield" style="color: var(--primary); margin-right: 8px;"></i>
                Verified Credential
              </h2>
              <span class="verified-pill">
                <i class="fa-solid fa-circle-check"></i> Authentic
              </span>
            </div>

            <div class="certificate-frame">
              <div class="certificate-watermark-overlay" aria-hidden="true">
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
                <div class="watermark-row">OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN • OFFICIAL PORTFOLIO VERIFICATION ONLY — SADEEPA LAKSHAN</div>
              </div>
              <img 
                src={award.certificateImage} 
                alt="Official Spirit of Service Certificate - Sadeepa Lakshan" 
                class="certificate-full-img"
                loading="eager"
              />
            </div>

            <div class="cert-footer-row">
              <span class="cert-caption">
                <i class="fa-solid fa-award" style="color: var(--accent-gold);"></i> RI Year 2024/25 • Rotaract UoM
              </span>
              <div class="cert-status-badge">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Protected Digital Credential</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Right: Award Citation, Credentials & Signatories -->
        <article class="terminal-card content-card details-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">Official Citation & Credentials</span>
          </div>
          
          <div class="terminal-body" style="padding: 1.4rem 1.5rem;">
            
            <div class="card-subtitle-row">
              <h2 class="section-heading" style="margin-bottom: 0;">
                <i class="fa-solid fa-certificate" style="color: var(--accent-gold); margin-right: 8px;"></i>
                Citation of Recognition
              </h2>
              <span class="verified-pill">
                <i class="fa-solid fa-medal"></i> Meritorious Honor
              </span>
            </div>

            <!-- Citation Blockquote -->
            <div class="citation-callout">
              <i class="fa-solid fa-quote-left quote-icon"></i>
              <blockquote class="citation-text">
                "{award.citation}"
              </blockquote>
              <div class="citation-author">
                — Conferred to <strong>{award.recipient}</strong> by Rotaract Club of University of Moratuwa
              </div>
            </div>

            <p style="color: var(--text-muted); font-size: 0.86rem; line-height: 1.55; margin-bottom: 1.1rem;">
              The <strong>Spirit of Service Award</strong> represents one of the most distinguished volunteer honors within Rotaract UoM, recognizing steadfast drive, passion, and selfless duty.
            </p>

            <!-- 4-Item Credentials Matrix -->
            <div class="credentials-balanced-grid">
              <div class="cred-item">
                <span class="cred-label">Award Title</span>
                <span class="cred-value">{award.title}</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Awardee</span>
                <span class="cred-value">{award.recipient}</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Host Organization</span>
                <span class="cred-value">{award.organization}</span>
              </div>
              <div class="cred-item">
                <span class="cred-label">Administrative Year</span>
                <span class="cred-value">RI Year 2024/25</span>
              </div>
            </div>

            <!-- Official Signatories Section -->
            <div class="signatories-section">
              <span class="cred-label" style="display: block; margin-bottom: 0.6rem;">Verified Signatories</span>
              <div class="signatories-balanced-row">
                {award.signatories.map(s => (
                  <div class="signatory-box">
                    <div class="signatory-name">
                      <i class="fa-solid fa-pen-nib" style="color: var(--primary); margin-right: 5px;"></i>
                      <strong>{s.name}</strong>
                    </div>
                    <div class="signatory-role">{s.role}</div>
                    <div class="signatory-org">{s.org}</div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </article>

      </div>

      <!-- 2. Community Initiatives: Full-Width 3-Column Balanced Section -->
      <article class="terminal-card content-card" style="margin-top: 1.8rem;">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="terminal-title">Community Impact & Leadership Portfolio</span>
        </div>
        
        <div class="terminal-body" style="padding: 1.8rem 2rem;">
          <div class="section-title-bar">
            <h2 class="section-heading" style="margin-bottom: 0;">
              <i class="fa-solid fa-hand-holding-heart" style="color: var(--secondary); margin-right: 8px;"></i>
              Key Community Initiatives Highlighted
            </h2>
            <span class="section-counter-badge">3 Major Engagements</span>
          </div>

          <p style="color: var(--text-muted); margin-bottom: 1.4rem; font-size: 0.9rem; line-height: 1.6;">
            The Spirit of Service recognition acknowledges dedicated service, leadership, and volunteer contributions across flagship Rotaract initiatives:
          </p>

          <div class="initiatives-grid-3col">
            
            <!-- Initiative 1: Nena Aruna Project 2024/25 -->
            <div class="initiative-card">
              <div class="initiative-top">
                <div class="initiative-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">
                  <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <span class="initiative-pill pill-sky">Leadership Role</span>
              </div>
              <div class="initiative-content">
                <h4 class="initiative-title">Nena Aruna Project 2024/25</h4>
                <div class="initiative-role">Project Co-Chairperson</div>
                <p>
                  Served as Project Co-Chairperson for the flagship educational and youth empowerment initiative. Orchestrated tutoring sessions, motivational mentoring, and educational supply donation drives for underprivileged school students.
                </p>
                <div style="margin-top: 1rem;">
                  <a href={`${baseUrl}awards/nena-aruna`} class="link-btn" style="font-size: 0.8rem; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-file-invoice"></i> View Letter of Appreciation <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              </div>
            </div>

            <!-- Initiative 2: Manusath Handa 2026 -->
            <div class="initiative-card">
              <div class="initiative-top">
                <div class="initiative-icon" style="background: rgba(62, 207, 142, 0.15); color: #3ecf8e;">
                  <i class="fa-solid fa-microphone-lines"></i>
                </div>
                <span class="initiative-pill pill-emerald">Volunteer Service</span>
              </div>
              <div class="initiative-content">
                <h4 class="initiative-title">Manusath Handa (2026)</h4>
                <div class="initiative-role">Volunteer Audio Voice Contributor</div>
                <p>
                  Personally voiced and recorded school textbook lessons to produce accessible audio learning guides for visually impaired students, fostering inclusive educational access across Sri Lanka.
                </p>
              </div>
            </div>

            <!-- Initiative 3: Binara Pedura 2024/25 -->
            <div class="initiative-card">
              <div class="initiative-top">
                <div class="initiative-icon" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24;">
                  <i class="fa-solid fa-guitar"></i>
                </div>
                <span class="initiative-pill pill-gold">Organizing Committee</span>
              </div>
              <div class="initiative-content">
                <h4 class="initiative-title">Binara Pedura 2024/25</h4>
                <div class="initiative-role">Organizing Committee Member &amp; Volunteer</div>
                <p>
                  Coordinated venue logistics, volunteer workflows, guest reception, and stage synchronization for the signature cultural and musical festival of the University of Moratuwa.
                </p>
              </div>
            </div>

          </div>
        </div>
      </article>

      <!-- 3. Core Leadership Attributes -->
      <article class="terminal-card content-card" style="margin-top: 1.8rem;">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="terminal-title">Service Pillars &amp; Core Values</span>
        </div>
        
        <div class="terminal-body" style="padding: 1.8rem 2rem;">
          <h2 class="section-heading" style="margin-bottom: 1.2rem;">
            <i class="fa-solid fa-compass" style="color: var(--accent-gold); margin-right: 8px;"></i>
            Attributes Embodied in the Spirit of Service
          </h2>

          <div class="pillars-grid-4col">
            <div class="pillar-box">
              <div class="pillar-num">01</div>
              <h4>Unconditional Service</h4>
              <p>Volunteering time and technical expertise selflessly to uplift underprivileged youth and create accessible education.</p>
            </div>
            <div class="pillar-box">
              <div class="pillar-num">02</div>
              <h4>Team Synchronization</h4>
              <p>Collaborating seamlessly within organizing committees to orchestrate high-visibility cultural and social campaigns.</p>
            </div>
            <div class="pillar-box">
              <div class="pillar-num">03</div>
              <h4>Project Ownership</h4>
              <p>Assuming end-to-end accountability as Project Co-Chairperson to deliver measurable impact on schedule.</p>
            </div>
            <div class="pillar-box">
              <div class="pillar-num">04</div>
              <h4>Inclusive Advocacy</h4>
              <p>Promoting accessibility and equity by providing voice narration and material aid to underserved student groups.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Bottom Action CTA -->
      <div class="github-cta-box" style="margin-top: 2.5rem;">
        <div class="cta-info">
          <i class="fa-solid fa-award cta-icon" style="color: var(--accent-gold);"></i>
          <div>
            <h4>Explore Recognition &amp; Technical Projects</h4>
            <p>Discover technical case studies in IoT, Edge-AI, and full-stack software development.</p>
          </div>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href={`${baseUrl}awards/nena-aruna`} class="btn btn-primary">
            <i class="fa-solid fa-file-invoice"></i> View Nena Aruna Letter
          </a>
          <a href={`${baseUrl}#awards`} class="btn btn-secondary">
            <i class="fa-solid fa-award"></i> View All Awards
          </a>
          <a href={`${baseUrl}#projects`} class="btn btn-secondary">
            <i class="fa-solid fa-folder-open"></i> View Projects
          </a>
          <a href={`${baseUrl}#contact`} class="btn btn-secondary">
            <i class="fa-solid fa-envelope"></i> Contact Sadeepa
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Compact Header Card */
  .award-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.6rem 2rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(12px);
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 0.8rem;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .pill-gold {
    background: rgba(251, 191, 36, 0.15);
    color: #fde68a;
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .pill-sky {
    background: rgba(56, 189, 248, 0.15);
    color: #bae6fd;
    border: 1px solid rgba(56, 189, 248, 0.4);
  }

  .pill-emerald {
    background: rgba(62, 207, 142, 0.15);
    color: #a7f3d0;
    border: 1px solid rgba(62, 207, 142, 0.4);
  }

  .award-page-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .award-page-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 880px;
    line-height: 1.55;
    margin-bottom: 1.2rem;
  }

  /* Inline Metrics Bar */
  .inline-metrics-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-color);
  }

  .inline-metric-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.9rem;
    text-align: center;
  }

  .inline-metric-label {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .inline-metric-value {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-gold);
    font-family: var(--font-mono);
  }

  /* Award Split Layout (Balanced 2 Columns) */
  .award-split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .terminal-header {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .card-subtitle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
  }

  .verified-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  /* Certificate Frame */
  .certificate-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    background: rgba(0, 0, 0, 0.2);
    margin-bottom: 0.8rem;
  }

  .certificate-full-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .cert-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 8px;
  }

  .cert-caption {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Citation Callout */
  .citation-callout {
    position: relative;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.08) 0%, rgba(15, 23, 42, 0.4) 100%);
    border-left: 3px solid var(--accent-gold);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 1.1rem 1.4rem;
    margin-bottom: 1rem;
  }

  .quote-icon {
    position: absolute;
    top: 0.8rem;
    right: 1.1rem;
    font-size: 1.6rem;
    color: rgba(251, 191, 36, 0.15);
  }

  .citation-text {
    font-size: 0.94rem;
    font-style: italic;
    color: var(--text-main);
    line-height: 1.6;
    margin: 0 0 0.5rem 0;
  }

  .citation-author {
    font-size: 0.8rem;
    color: var(--accent-gold);
    font-weight: 500;
  }

  /* Credentials Balanced Grid */
  .credentials-balanced-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem 1.1rem;
    margin-bottom: 1.1rem;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .cred-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cred-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cred-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }

  /* Signatories Section */
  .signatories-section {
    border-top: 1px dashed var(--border-color);
    padding-top: 0.9rem;
  }

  .signatories-balanced-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
  }

  .signatory-box {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.8rem;
  }

  .signatory-name {
    font-size: 0.82rem;
    color: var(--text-main);
    line-height: 1.3;
  }

  .signatory-role {
    font-size: 0.72rem;
    color: var(--accent-gold);
    margin-top: 0.15rem;
  }

  .signatory-org {
    font-size: 0.66rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  /* Workstreams & Pillars */
  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 0.6rem;
  }

  .section-counter-badge {
