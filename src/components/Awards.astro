---
// Awards and Leadership Section
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="awards section" id="awards">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">// RECOGNITION & LEADERSHIP</span>
            <h2 class="section-title">Awards & <span class="text-gradient">Leadership</span></h2>
            <div class="section-line"></div>
        </div>

        <div class="awards-grid">
            <!-- Award 1 -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-trophy"></i></div>
                <div class="award-info">
                    <span class="award-badge">2nd Place Winner</span>
                    <h3>IEEE CS R10 Summer School 2026 Mini-Ideathon</h3>
                    <p>Awarded 2nd Place with <strong>Team Busy Bees</strong> for innovative technical solution design and presentation.</p>
                    <div style="margin-top: 1.1rem;">
                        <a href={`${baseUrl}projects/ae-sss`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-file-lines"></i> View Architecture & Case Study <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Award 2: FIT Expo 2025 -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-certificate"></i></div>
                <div class="award-info">
                    <span class="award-badge">Exhibition Recognition</span>
                    <h3>Certificate of Appreciation — FIT Expo 2025</h3>
                    <p>Awarded by the <strong>Faculty of Information Technology, University of Moratuwa</strong> to Batch 23 for microcontroller-based project <em>AbacusGenius 1.0</em> demonstrated at the exhibition.</p>
                    <div style="margin-top: 1.1rem;">
                        <a href={`${baseUrl}projects/abacus`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-file-lines"></i> View Exhibition Case Study <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Award 3 -->
            <div class="award-card">
                <div class="award-icon"><i class="fa-solid fa-award"></i></div>
                <div class="award-info">
                    <span class="award-badge">Rotaract Recognition</span>
                    <h3>Spirit of Service Award 2024/25</h3>
                    <p>Awarded by the <strong>Rotaract Club of University of Moratuwa</strong> for outstanding dedication to community impact projects.</p>
                </div>
            </div>

            <!-- Leadership 1 -->
            <div class="award-card">
                <div class="award-icon"><i class="fa-solid fa-user-tie"></i></div>
                <div class="award-info">
                    <span class="award-badge">University Leadership</span>
                    <h3>Batch Representative (Level 3)</h3>
                    <p>Faculty of Information Technology, <strong>University of Moratuwa</strong>. Representing student body and coordinating faculty initiatives.</p>
                </div>
            </div>

            <!-- Leadership 2 -->
            <div class="award-card">
                <div class="award-icon"><i class="fa-solid fa-people-group"></i></div>
                <div class="award-info">
                    <span class="award-badge">Project Leadership</span>
                    <h3>Co-Chairperson: Nena Aruna Project</h3>
                    <p>Rotaract Club of University of Moratuwa (2024/25). Led community education projects and volunteer teams (Binara Pedura, Manusath Handa).</p>
                </div>
            </div>
        </div>
    </div>
</section>
