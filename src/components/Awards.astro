---
// Awards and Leadership Section
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="awards section" id="awards">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">// RECOGNITION & LEADERSHIP</span>
            <h2 class="section-title">Awards & <span class="text-gradient">Leadership</span></h2>
            <div class="section-line"></div>
        </div>

        <div class="awards-grid">
            <!-- Award 1 -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-trophy"></i></div>
                <div class="award-info">
                    <span class="award-badge">2nd Place Winner</span>
                    <h3>IEEE CS R10 Summer School 2026 Mini-Ideathon</h3>
                    <p>Awarded 2nd Place with <strong>Team Busy Bees</strong> for innovative technical solution design and presentation.</p>
                    <div style="margin-top: 1.1rem; display: flex; gap: 8px; flex-wrap: wrap;">
                        <a href={`${baseUrl}awards/ieee-cs-r10`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-award"></i> View Certificate Details <i class="fa-solid fa-arrow-right"></i>
                        </a>
                        <a href={`${baseUrl}projects/ae-sss`} class="btn btn-sm btn-secondary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-brain"></i> Architecture Case Study
                        </a>
                    </div>
                </div>
            </div>

            <!-- Award 2: FIT Expo 2025 -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-certificate"></i></div>
                <div class="award-info">
                    <span class="award-badge">Exhibition Recognition</span>
                    <h3>Certificate of Appreciation - FIT Expo 2025</h3>
                    <p>Awarded by the <strong>Faculty of Information Technology, University of Moratuwa</strong> to Batch 23 for microcontroller-based project <em>AbacusGenius 1.0</em> demonstrated at the exhibition.</p>
                    <div style="margin-top: 1.1rem;">
                        <a href={`${baseUrl}projects/abacus`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-file-lines"></i> View Exhibition Case Study <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Award 3: Rotaract Spirit of Service Award -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-award"></i></div>
                <div class="award-info">
                    <span class="award-badge">Rotaract Recognition</span>
                    <h3>Spirit of Service Award 2024/25</h3>
                    <p>Awarded by the <strong>Rotaract Club of University of Moratuwa</strong> for showcasing immense drive, passion, and commitment in upholding the true spirit of service and duty throughout the RI year 2024/25 through their dedicated time and effort.</p>
                    <div style="margin-top: 1.1rem;">
                        <a href={`${baseUrl}awards/spirit-of-service`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-medal"></i> View Award Details <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Award 4: Project Co-Chairperson (Project Nena Aruna 2024/25) -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-file-invoice"></i></div>
                <div class="award-info">
                    <span class="award-badge">Rotaract Recognition</span>
                    <h3>Project Co-Chairperson (Project Nena Aruna 2024/25)</h3>
                    <p>Awarded by the <strong>Rotaract Club of University of Moratuwa</strong> in recognition of role as Project Co-chairperson of project Nena Aruna 2024/25 for invaluable contributions, dedication, and community impact.</p>
                    <div style="margin-top: 1.1rem;">
                        <a href={`${baseUrl}awards/nena-aruna`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-file-invoice"></i> View Recognition Details <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Leadership 1 -->
            <div class="award-card">
                <div class="award-icon"><i class="fa-solid fa-user-tie"></i></div>
                <div class="award-info">
                    <span class="award-badge">University Leadership</span>
                    <h3>Batch Representative (Level 3)</h3>
                    <p>Faculty of Information Technology, <strong>University of Moratuwa</strong>. Representing student body and coordinating faculty initiatives.</p>
                </div>
            </div>

            <!-- Leadership 2: Deputy Head Prefect -->
            <div class="award-card highlight-award">
                <div class="award-icon"><i class="fa-solid fa-graduation-cap"></i></div>
                <div class="award-info">
                    <span class="award-badge">School Leadership</span>
                    <h3>Deputy Head Prefect Certificate</h3>
                    <p>Awarded by <strong>A/ Mankadawala Maha Vidyalaya, Saliyapura</strong> for serving as Deputy Head Prefect (2021/2022) and leading the Prefect Guild since 2019.</p>
                    <div style="margin-top: 1.1rem;">
                        <a href={`${baseUrl}awards/deputy-head-prefect`} class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-award"></i> View Certificate Details <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
