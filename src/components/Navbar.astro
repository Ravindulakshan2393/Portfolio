---
interface Props {
  isHome?: boolean;
}

const { isHome = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="navbar" id="navbar">
    <div class="nav-container">
        <a href={`${baseUrl}#hero`} class="nav-brand">
            <img src={`${baseUrl}assets/symbol.png`} alt="Emblem" class="brand-symbol-img" />
            <span class="brand-name">Sadeepa Lakshan</span>
        </a>

        <nav class="nav-menu" id="nav-menu">
            <a href={`${baseUrl}#hero`} class={`nav-link ${isHome ? 'active' : ''}`} id="nav-link-hero">Home</a>
            <a href={`${baseUrl}#about`} class="nav-link" id="nav-link-about">About</a>
            <a href={`${baseUrl}#skills`} class="nav-link" id="nav-link-skills">Skills</a>
            <a href={`${baseUrl}#projects`} class="nav-link" id="nav-link-projects">Projects</a>
            <a href={`${baseUrl}#awards`} class="nav-link" id="nav-link-awards">Awards</a>
            <a href={`${baseUrl}#github-stats`} class="nav-link" id="nav-link-stats">Stats</a>
            <a href={`${baseUrl}#contact`} class="nav-link" id="nav-link-contact">Contact</a>
        </nav>

        <div class="nav-actions">
            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle Theme">
                <i class="fa-solid fa-moon"></i>
            </button>
            <a href={`${baseUrl}#contact`} class="btn btn-sm btn-primary">Hire Me</a>
            <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </div>
</header>
