---
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!-- Featured Projects Section -->
<section class="projects section" id="projects">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">// PORTFOLIO PROJECTS</span>
            <h2 class="section-title">Featured <span class="text-gradient">Projects</span></h2>
            <div class="section-line"></div>
        </div>

        <!-- Project Filters -->
        <div class="category-filters">
            <button class="project-filter-btn active" data-project-category="all" id="proj-filter-all">All</button>
            <button class="project-filter-btn" data-project-category="web" id="proj-filter-web">Web Apps</button>
            <button class="project-filter-btn" data-project-category="iot" id="proj-filter-iot">IoT Devices</button>
        </div>

        <div class="projects-grid">
            <!-- Project 1: ConTrack -->
            <div class="project-card" data-project-cat="web">
                <div class="project-image-wrapper">
                    <div class="project-graphic web-graphic">
                        <div class="window-bar">
                            <span class="dot-btn"></span><span class="dot-btn"></span><span class="dot-btn"></span>
                            <span class="window-title">ConTrack: Container Transportation System</span>
                        </div>
                        <div class="graphic-content">
                            <div class="mock-header"></div>
                            <div class="mock-grid">
                                <div class="mock-card glow-cyan"></div>
                                <div class="mock-card glow-purple"></div>
                                <div class="mock-card glow-blue"></div>
                            </div>
                        </div>
                    </div>
                    <div class="project-overlay">
                        <a href={`${baseUrl}projects/contrack`} class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-file-lines"></i> View Case Study
                        </a>
                        <a href="https://github.com/hemi-chk/conntrack-new.git" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" style="margin-left: 8px;">
                            <i class="fa-brands fa-github"></i> Repository
                        </a>
                    </div>
                </div>

                <div class="project-content">
                    <span class="project-type"><i class="fa-solid fa-building" style="color: var(--primary); margin-right: 4px;"></i> Client: Rysera Innovations · IS2901 Project</span>
                    <h3 class="project-title">ConTrack: Container Transportation Management System</h3>
                    <p class="project-desc">
                        Container transport management web platform built for Rysera Innovations featuring supplier bidding engine, driver/fleet management, checkpoint clearance tracking, and document upload workflow leveraging Supabase Storage.
                    </p>
                    <div class="project-tags">
                        <span class="tag">React.js</span>
                        <span class="tag">Node.js</span>
                        <span class="tag">Express.js</span>
                        <span class="tag">Supabase</span>
                        <span class="tag">Tailwind CSS</span>
                    </div>
                    <div class="project-links">
                        <a href="https://github.com/hemi-chk/conntrack-new.git" target="_blank" rel="noopener noreferrer" class="link-btn">
                            <i class="fa-brands fa-github"></i> Repository
                        </a>
                        <a href={`${baseUrl}projects/contrack`} class="link-btn">
                            Case Study <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 2: Abacus Genius 1.0 -->
            <div class="project-card" data-project-cat="iot">
                <div class="project-image-wrapper">
                    <div class="project-graphic iot-graphic">
                        <div class="window-bar">
                            <span class="dot-btn"></span><span class="dot-btn"></span><span class="dot-btn"></span>
                            <span class="window-title">Abacus Genius 1.0 Device</span>
                        </div>
                        <div class="graphic-content iot-content">
                            <div class="sensor-chip">
                                <i class="fa-solid fa-microchip"></i>
                                <span>Arduino Mega + ESP8266</span>
                            </div>
                            <div class="sensor-values">
                                <div class="s-val"><span>Input</span><b>Keypad & 4 Encoders</b></div>
                                <div class="s-val"><span>Audio</span><b>DFPlayer Mini</b></div>
                            </div>
                        </div>
                    </div>
                    <div class="project-overlay">
                        <a href={`${baseUrl}projects/abacus`} class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-file-lines"></i> View Case Study
                        </a>
                        <a href="https://github.com/Ravindulakshan2393/Abacus-Genius-1.0.git" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" style="margin-left: 8px;">
                            <i class="fa-brands fa-github"></i> Repository
                        </a>
                    </div>
                </div>

                <div class="project-content">
                    <span class="project-type"><i class="fa-solid fa-certificate" style="color: var(--accent-gold); margin-right: 4px;"></i> FIT Expo 2025 Exhibitor</span>
                    <h3 class="project-title">Abacus Genius 1.0</h3>
                    <p class="project-desc">
                        Interactive educational hardware device integrated with Arduino Mega, ESP8266 wireless communication, rotary encoders, 16×2 LCD, 4×4 keypad, DFPlayer Mini audio module, motion/touch sensors, and smart power management. Exhibited at FIT Expo 2025 (UoM).
                    </p>
                    <div class="project-tags">
                        <span class="tag">Arduino Mega</span>
                        <span class="tag">ESP8266</span>
                        <span class="tag">Embedded C++</span>
                        <span class="tag">Rotary Encoders</span>
                        <span class="tag">DFPlayer Mini</span>
                    </div>
                    <div class="project-links">
                        <a href="https://github.com/Ravindulakshan2393/Abacus-Genius-1.0.git" target="_blank" rel="noopener noreferrer" class="link-btn">
                            <i class="fa-brands fa-github"></i> Repository
                        </a>
                        <a href={`${baseUrl}projects/abacus`} class="link-btn">
                            Case Study <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 3: AE-SSS Smart Surveillance System -->
            <div class="project-card" data-project-cat="iot">
                <div class="project-image-wrapper">
                    <div class="project-graphic iot-graphic" style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.12) 0%, rgba(15, 23, 42, 0.95) 100%);">
                        <div class="window-bar">
                            <span class="dot-btn"></span><span class="dot-btn"></span><span class="dot-btn"></span>
                            <span class="window-title">AE-SSS: Edge-AI Surveillance</span>
                        </div>
                        <div class="graphic-content iot-content">
                            <div class="sensor-chip" style="border-color: rgba(56, 189, 248, 0.4);">
                                <i class="fa-solid fa-brain" style="color: var(--primary);"></i>
                                <span>Jetson Orin Nano + Edge-AI</span>
                            </div>
                            <div class="sensor-values">
                                <div class="s-val"><span>Latency</span><b>&lt; 50 ms</b></div>
                                <div class="s-val"><span>Bandwidth Saved</span><b>&gt; 99%</b></div>
                            </div>
                        </div>
                    </div>
                    <div class="project-overlay">
                        <a href={`${baseUrl}projects/ae-sss`} class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-file-lines"></i> View Concept Case Study
                        </a>
                        <a href="https://github.com/chamika-u/mini-ideathon-smart-ecosystem.git" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" style="margin-left: 8px;">
                            <i class="fa-brands fa-github"></i> Repository
                        </a>
                    </div>
                </div>

                <div class="project-content">
                    <span class="project-type">Edge-AI Multi-Agent Architecture</span>
                    <h3 class="project-title">AE-SSS: Smart Surveillance & Response System</h3>
                    <p class="project-desc">
                        Decentralized multi-agent edge-AI architecture for high-density transit hubs (Pettah Bus Stand) running on NVIDIA Jetson Orin Nano with 5-stage control loop and privacy-by-design RAM scrubbing.
                    </p>
                    <div class="project-tags">
                        <span class="tag">System Architecture</span>
                        <span class="tag">Multi-Agent AI</span>
                        <span class="tag">Edge Computing</span>
                        <span class="tag">Jetson Orin Nano</span>
                    </div>
                    <div class="project-links">
                        <a href="https://github.com/chamika-u/mini-ideathon-smart-ecosystem.git" target="_blank" rel="noopener noreferrer" class="link-btn">
                            <i class="fa-brands fa-github"></i> Repository
                        </a>
                        <a href={`${baseUrl}projects/ae-sss`} class="link-btn">
                            Case Study <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
