---
// ProjectModal component for displaying deep specifications in modal
---

<!-- Modal for Project Details -->
<div class="modal-overlay" id="project-modal">
    <div class="modal-content">
        <button class="modal-close" id="modal-close" aria-label="Close Modal"><i class="fa-solid fa-xmark"></i></button>
        <div class="modal-body" id="modal-body">
            <!-- Injected via JS -->
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="toast" id="toast">
    <i class="fa-solid fa-circle-check toast-icon"></i>
    <span id="toast-message">Message sent successfully!</span>
</div>
