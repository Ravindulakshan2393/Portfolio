---
// Technical Skills Section
---

<section class="skills section" id="skills">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">// MY TOOLBOX</span>
            <h2 class="section-title">Technical <span class="text-gradient">Skills</span></h2>
            <div class="section-line"></div>
        </div>

        <!-- Category Pills -->
        <div class="category-filters">
            <button class="filter-btn active" data-category="all" id="skill-filter-all">All Skills</button>
            <button class="filter-btn" data-category="languages" id="skill-filter-lang">Programming</button>
            <button class="filter-btn" data-category="frameworks" id="skill-filter-fw">Web Dev</button>
            <button class="filter-btn" data-category="databases" id="skill-filter-db">Databases</button>
            <button class="filter-btn" data-category="tools" id="skill-filter-tools">Tools & Hardware</button>
        </div>

        <!-- Skills Grid -->
        <div class="skills-grid" id="skills-grid">
            <!-- Programming Languages -->
            <div class="skill-card" data-category="languages">
                <i class="devicon-javascript-plain colored skill-icon"></i>
                <span class="skill-name">JavaScript</span>
                <span class="skill-badge">Advanced</span>
            </div>
            <div class="skill-card" data-category="languages">
                <i class="devicon-c-plain colored skill-icon"></i>
                <span class="skill-name">C</span>
                <span class="skill-badge">Proficient</span>
            </div>
            <div class="skill-card" data-category="languages">
                <i class="devicon-html5-plain colored skill-icon"></i>
                <span class="skill-name">HTML5</span>
                <span class="skill-badge">Advanced</span>
            </div>
            <div class="skill-card" data-category="languages">
                <i class="devicon-css3-plain colored skill-icon"></i>
                <span class="skill-name">CSS3</span>
                <span class="skill-badge">Advanced</span>
            </div>

            <!-- Web Development -->
            <div class="skill-card" data-category="frameworks">
                <i class="devicon-react-original colored skill-icon"></i>
                <span class="skill-name">React</span>
                <span class="skill-badge">Advanced</span>
            </div>
            <div class="skill-card" data-category="frameworks">
                <i class="devicon-nodejs-plain colored skill-icon"></i>
                <span class="skill-name">Node.js</span>
                <span class="skill-badge">Proficient</span>
            </div>
            <div class="skill-card" data-category="frameworks">
                <i class="devicon-express-original skill-icon"></i>
                <span class="skill-name">Express.js</span>
                <span class="skill-badge">Proficient</span>
            </div>

            <!-- Databases -->
            <div class="skill-card" data-category="databases">
                <i class="devicon-mysql-plain colored skill-icon"></i>
                <span class="skill-name">MySQL</span>
                <span class="skill-badge">Proficient</span>
            </div>
            <div class="skill-card" data-category="databases">
                <i class="devicon-postgresql-plain colored skill-icon"></i>
                <span class="skill-name">PostgreSQL</span>
                <span class="skill-badge">Proficient</span>
            </div>
            <div class="skill-card" data-category="databases">
                <i class="devicon-supabase-plain colored skill-icon"></i>
                <span class="skill-name">Supabase</span>
                <span class="skill-badge">Proficient</span>
            </div>
            <div class="skill-card" data-category="databases">
                <i class="devicon-mongodb-plain colored skill-icon"></i>
                <span class="skill-name">MongoDB</span>
                <span class="skill-badge">Proficient</span>
            </div>

            <!-- Tools & Hardware -->
            <div class="skill-card" data-category="tools">
                <i class="devicon-git-plain colored skill-icon"></i>
                <span class="skill-name">Git</span>
                <span class="skill-badge">Advanced</span>
            </div>
            <div class="skill-card" data-category="tools">
                <i class="devicon-github-original skill-icon"></i>
                <span class="skill-name">GitHub</span>
                <span class="skill-badge">Advanced</span>
            </div>
            <div class="skill-card" data-category="tools">
                <i class="devicon-vscode-plain colored skill-icon"></i>
                <span class="skill-name">VS Code</span>
                <span class="skill-badge">Expert</span>
            </div>
            <div class="skill-card" data-category="tools">
                <i class="devicon-arduino-plain colored skill-icon"></i>
                <span class="skill-name">Arduino Mega & ESP8266</span>
                <span class="skill-badge">Proficient</span>
            </div>
        </div>
    </div>
</section>
