---
// GitHub Stats Dashboard Section
---

<section class="github-stats section" id="github-stats">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">// LIVE ACTIVITY</span>
            <h2 class="section-title">GitHub Analytics & <span class="text-gradient">Trophies</span></h2>
            <div class="section-line"></div>
        </div>

        <div class="stats-wrapper">
            <div class="stats-grid">
                <div class="stat-card-embed">
                    <img src="https://github-profile-summary-cards.vercel.app/api/cards/profile-details?username=Ravindulakshan2393&theme=tokyonight" alt="GitHub Profile Summary" class="github-img" loading="lazy" />
                </div>
                <div class="stat-card-embed">
                    <img src="https://github-profile-summary-cards.vercel.app/api/cards/repos-per-language?username=Ravindulakshan2393&theme=tokyonight" alt="Repos Per Language" class="github-img" loading="lazy" />
                </div>
            </div>

            <div class="trophies-container">
                <img src="https://github-profile-trophies.vercel.app/?username=Ravindulakshan2393&theme=tokyonight&no-frame=true" alt="GitHub Trophies" class="github-img-full" loading="lazy" />
            </div>

            <div class="github-cta-box">
                <div class="cta-info">
                    <i class="fa-brands fa-github cta-icon"></i>
                    <div>
                        <h4>Explore My Code Repositories</h4>
                        <p>Follow my journey, star my projects, or fork repos on GitHub.</p>
                    </div>
                </div>
                <a href="https://github.com/Ravindulakshan2393" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    <i class="fa-brands fa-github"></i> Visit @Ravindulakshan2393
                </a>
            </div>
        </div>
    </div>
</section>
