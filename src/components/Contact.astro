---
// Contact Section
---

<section class="contact section" id="contact">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">// GET IN TOUCH</span>
            <h2 class="section-title">
                Let's <span class="text-gradient">Connect</span>
            </h2>
            <div class="section-line"></div>
        </div>

        <div class="contact-grid">
            <div class="contact-info">
                <h3>
                    Seeking Software Engineering & Software Development
                    Internships
                </h3>
                <p>
                    I am actively seeking an internship opportunity in Software
                    Engineering or Software Development. Feel free to contact me
                    via email, LinkedIn, or the message form below!
                </p>

                <div class="info-list">
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <span>Location</span>
                            <strong>Moratuwa / Colombo, Sri Lanka</strong>
                        </div>
                    </div>

                    <a
                        href="mailto:pererawslr@gmail.com?subject=Software%20Engineering%20Internship%20Inquiry%20-%20Sadeepa%20Lakshan&body=Hi%20Sadeepa%2C%0D%0A%0D%0AI%20came%20across%20your%20portfolio%20and%20would%20like%20to%20connect%20regarding%20a%20Software%20Engineering%20opportunity.%0D%0A%0D%0ABest%20regards%2C"
                        class="info-item email-link"
                        title="Click to open email app (auto-copies address to clipboard)"
                    >
                        <div class="info-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <div>
                            <span>Email Me</span>
                            <strong>pererawslr@gmail.com</strong>
                        </div>
                    </a>

                    <a
                        href="https://www.linkedin.com/in/sadeepa-lakshan-587690308"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="info-item"
                    >
                        <div class="info-icon">
                            <i class="fa-brands fa-linkedin-in"></i>
                        </div>
                        <div>
                            <span>LinkedIn Profile</span>
                            <strong>in/sadeepa-lakshan</strong>
                        </div>
                    </a>

                    <a
                        href="https://github.com/Ravindulakshan2393"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="info-item"
                    >
                        <div class="info-icon">
                            <i class="fa-brands fa-github"></i>
                        </div>
                        <div>
                            <span>GitHub Username</span>
                            <strong>@Ravindulakshan2393</strong>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="contact-form-card">
                <form id="contact-form" class="contact-form">
                    <!-- Web3Forms Access Key -->
                    <input type="hidden" name="access_key" value="1593425e-a113-4be4-8b07-4ff64352eb9e" />
                    <!-- Anti-Spam Honeypot Field -->
                    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
                    <!-- Custom From Name Identifier -->
                    <input type="hidden" name="from_name" value="Sadeepa Lakshan Portfolio Visitor" />

                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="John Doe"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="email">Your Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="john@example.com"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="subject">Subject</label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            placeholder="Software Engineering Internship / Inquiry"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            placeholder="Hi Sadeepa, I'd like to invite you for an interview..."
                            required></textarea>
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary btn-block"
                        id="submit-btn"
                    >
                        <i class="fa-solid fa-paper-plane"></i> Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
